{
  "name": "whatsapp-bulk-messenger",
  "version": "1.0.0",
  "description": "Automated WhatsApp bulk messaging tool built with Node.js and whatsapp-web.js for GDSC event PR broadcasts",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/patch-wwebjs.js",
    "start": "node index.js contact.csv",
    "single": "node send_single.js contacts.csv",
    "add-leaders": "node add_team_leaders.js t1.csv",
    "add-leaders:dry": "node add_team_leaders.js t1.csv --dry-run",
    "test": "node test_send.js",
    "test:parser": "node test_leader_parser.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xombi17/whatsapp-pr-messaging.git"
  },
  "keywords": [
    "whatsapp",
    "bulk-messaging",
    "whatsapp-web.js",
    "automation",
    "gdsc",
    "bnb"
  ],
  "author": "GDSC Team",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Xombi17/whatsapp-pr-messaging/issues"
  },
  "homepage": "https://github.com/Xombi17/whatsapp-pr-messaging#readme",
  "dependencies": {
    "csv-parse": "^6.2.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  }
}
